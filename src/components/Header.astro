
---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const current = Astro.url.pathname.startsWith(base)
  ? '/' + Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;

const links = [
  { href: base, label: 'Home', path: '/' },
  { href: `${base}about/`, label: 'About', path: '/about/' },
  { href: `${base}services/`, label: 'Services', path: '/services/' },
  { href: `${base}contact/`, label: 'Contact', path: '/contact/' }
];
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Your Name home">
    <span class="brand-mark">✳</span>
    <span>TWD<span class="brand-accent">Kenneth</span></span>
  </a>

  <button
    class="menu-toggle"
    aria-label="Toggle navigation"
    aria-expanded="false"
  >
    ☰
  </button>

  <nav class="nav-links" aria-label="Main navigation">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={{ active: current === link.path }}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <a class="header-cta" href={`${base}contact/`}>
    Let's talk <span>↗</span>
  </a>
</header>
