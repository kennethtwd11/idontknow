
---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Your Name — Creative Portfolio"
  description="A colorful portfolio of creative strategy, design, and digital experiences."
>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        AVAILABLE FOR SELECT PROJECTS
      </div>

      <h1>
        I turn big ideas into <span class="marker">bold</span> experiences<span class="period">.</span>
      </h1>

      <p class="hero-intro">
        Hey, I'm <strong>Your Name</strong> — a creative thinker and digital maker helping ambitious people bring meaningful ideas to life.
      </p>

      <div class="hero-actions">
        <a class="button button-dark" href={`${base}contact/`}>
          Start a project <span>↗</span>
        </a>
        <a class="text-link" href={`${base}about/`}>
          More about me <span>→</span>
        </a>
      </div>

      <div class="hero-note">
        <span class="note-star">✳</span>
        <span>
          Curious mind. Thoughtful work.<br />
          A little bit of happy chaos.
        </span>
      </div>
    </div>

    <div class="hero-art" aria-label="Abstract colorful creative artwork">
      <div class="art-circle"></div>
      <div class="art-orange"></div>
      <div class="art-pink"></div>

      <div class="art-card">
        <span>MAKE<br />IT <em>MATTER.</em></span>
        <small>CREATIVITY WITH PURPOSE — 01/01</small>
      </div>

      <div class="art-spark">✳</div>
      <div class="art-smile">☺</div>
      <div class="art-label">
        GOOD<br />THINGS<br />HAPPEN<br />HERE.
      </div>
    </div>
  </section>

  <section class="ticker" aria-label="What I do">
    <div>
      DESIGN WITH INTENTION <span>✳</span>
      THINK BIGGER <span>✳</span>
      MAKE IT HAPPEN <span>✳</span>
      STAY CURIOUS <span>✳</span>
      DESIGN WITH INTENTION <span>✳</span>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A FEW THINGS I DO</p>
        <h2>
          Good work.<br />
          <span class="serif">Good energy.</span>
        </h2>
      </div>

      <p class="section-lead">
        From the first spark of an idea to the final tiny detail, I bring clarity, curiosity, and care to every project.
      </p>
    </div>

    <div class="service-grid">
      <article class="service-card card-yellow">
        <span class="card-number">01 / STRATEGY</span>
        <div class="card-icon">✳</div>
        <h3>Find the<br />big idea.</h3>
        <p>
          Creative direction and clear thinking that give your project a strong point of view.
        </p>
        <a href={`${base}services/`}>Explore services ↗</a>
      </article>

      <article class="service-card card-pink">
        <span class="card-number">02 / DESIGN</span>
        <div class="card-icon">◒</div>
        <h3>Make it<br />memorable.</h3>
        <p>
          Visual identities and digital experiences people remember for all the right reasons.
        </p>
        <a href={`${base}services/`}>Explore services ↗</a>
      </article>

      <article class="service-card card-blue">
        <span class="card-number">03 / DIGITAL</span>
        <div class="card-icon">↗</div>
        <h3>Bring it<br />to life.</h3>
        <p>
          Thoughtful websites and practical digital solutions built around real people.
        </p>
        <a href={`${base}services/`}>Explore services ↗</a>
      </article>
    </div>
  </section>

  <section class="feature-band">
    <div class="wrap feature-inner">
      <div class="feature-sticker">
        ✳
        <small>THE GOOD<br />STUFF</small>
      </div>

      <div>
        <p class="eyebrow">A LITTLE ABOUT MY APPROACH</p>
        <h2>
          Less noise.<br />
          <span class="serif">More meaning.</span>
        </h2>
        <p>
          I believe the best creative work feels fresh, solves a real problem, and makes someone’s day a little better.
        </p>
        <a class="button button-light" href={`${base}about/`}>
          Get to know me <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap closing-cta">
    <p class="eyebrow">HAVE SOMETHING IN MIND?</p>
    <h2>
      Let's make<br />
      <span class="serif">something good.</span>
    </h2>
    <a class="button button-dark" href={`${base}contact/`}>
      Tell me about it <span>↗</span>
    </a>
    <div class="cta-doodle">✳</div>
  </section>
</BaseLayout>
