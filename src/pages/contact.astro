---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Your Name" description="Tell me about your next creative project.">
  <section class="page-hero wrap"><p class="eyebrow">YOUR TURN</p><h1>Got a good<br/><span class="marker">feeling</span> about this?</h1><p class="page-intro">Tell me what you’re thinking. Big brief, tiny question, half-formed idea — I’m all ears.</p></section>
  <section class="contact-layout wrap"><div class="contact-aside"><div class="contact-sticker">LET'S<br/><span>MAKE</span><br/>IT HAPPEN <b>↗</b></div><p class="eyebrow">PREFER EMAIL?</p><a class="email-link" href="mailto:hello@example.com">hello@example.com ↗</a><p class="muted">Usually replies within 2 business days.</p><div class="social-links"><a href="https://www.instagram.com/" target="_blank" rel="noreferrer">Instagram ↗</a><a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div><form class="contact-form" action="mailto:hello@example.com" method="post" enctype="text/plain"><label>Your name<input name="Name" type="text" placeholder="What should I call you?" required /></label><label>Email address<input name="Email" type="email" placeholder="you@example.com" required /></label><label>What do you need help with?<select name="Project type"><option>Choose a service</option><option>Creative direction</option><option>Brand & design</option><option>Website</option><option>Something else</option></select></label><label>A little about your project<textarea name="Message" rows="5" placeholder="The idea, the goal, the big dream..." required></textarea></label><button class="button button-dark" type="submit">Send your message <span>↗</span></button><p class="form-note">This starter form opens your email app. Connect a form service or backend for direct website submissions.</p></form></section>
</BaseLayout>
